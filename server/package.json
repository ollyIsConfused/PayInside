{
  "name": "payinside-server",
  "version": "0.1.0",
  "description": "Pay Inside – Scan & Go Backend, Händler-Portal und Web-Shopper",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate-cli.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vendor": "npm i --no-save @zxing/browser && cp node_modules/@zxing/browser/umd/zxing-browser.min.js public/vendor/",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
