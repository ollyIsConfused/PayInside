# ---- Pflicht ----
DOMAIN=payinside.de
POSTGRES_PASSWORD=bitte-langes-zufaelliges-passwort
# 32+ zufällige Zeichen, z. B.:  openssl rand -hex 32
SESSION_SECRET=

# ---- Zahlungen (Stripe Connect) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Signing-Secret(s) der Webhooks (Plattform + Connect, kommagetrennt)
STRIPE_WEBHOOK_SECRET=whsec_...,whsec_...

# ---- TSE (fiskaly SIGN DE) ----
FISKALY_API_KEY=
FISKALY_API_SECRET=
FISKALY_BASE_URL=https://kassensichv-middleware.fiskaly.com/api/v2

# ---- Gebühren (deine Einnahmen) ----
# 250 = 2,5 % + 35 Cent pro Einkauf. Davon zahlst du die Stripe-Gebühren, der Rest ist deine Marge.
PLATFORM_FEE_BPS=250
PLATFORM_FEE_FIXED_CENTS=35
DEFAULT_AUDIT_RATE=0.03

# ---- iOS-App ----
APPLE_TEAM_ID=
IOS_BUNDLE_ID=de.payinside.app
IOS_APP_STORE_ID=
APPLE_PAY_MERCHANT_ID=merchant.de.payinside

# ---- Impressum ----
COMPANY_NAME=Pay Inside
COMPANY_OWNER=Vorname Nachname
COMPANY_ADDRESS=Straße 1, 12345 Ort
COMPANY_EMAIL=hallo@payinside.de
COMPANY_PHONE=
COMPANY_VAT_ID=
